# Optional fw3 example; replace the documentation address and verify generated rules.
# Merge only these sections into your private UCI firewall configuration.
config redirect 'phone_turn_tls'
    option name 'Phone-TURN-TLS'
    option src 'wan'
    option dest 'lan'
    option target 'DNAT'
    option proto 'tcp'
    option src_dport '8443'
    option dest_ip '192.0.2.10'
    option dest_port '5349'
    option reflection '1'

config redirect 'phone_turn_relay'
    option name 'Phone-TURN-Relay'
    option src 'wan'
    option dest 'lan'
    option target 'DNAT'
    option proto 'udp'
    option src_dport '52000-52063'
    option dest_ip '192.0.2.10'
    option dest_port '52000-52063'
    option reflection '1'
    option reflection_src 'external'
    list reflection_zone 'lan'
