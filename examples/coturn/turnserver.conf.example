# 地址仅用于文档示例；复制到私有配置后按实际网络修改。
listening-ip=192.0.2.10
relay-ip=192.0.2.10
listening-port=5348
tls-listening-port=5349
min-port=52000
max-port=52063
relay-threads=2
realm=turn.example.com
server-name=turn.example.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_PRIVATE_SECRET
cert=/certificates/fullchain.pem
pkey=/certificates/privkey.pem
no-tcp
no-udp
no-dtls
no-tcp-relay
no-cli
no-tlsv1
no-tlsv1_1
no-multicast-peers
no-dynamic-ip-list
no-software-attribute
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
# 当前控制台 WebRTC 后端仅使用 IPv4。
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# 仅用于局域网验证：双方使用本机中继分配。
# 发布公网中继地址时，应重新审查这一例外。
# allowed-peer-ip=YOUR_EXPLICITLY_APPROVED_RELAY_ADDRESS
user-quota=2
total-quota=8
max-bps=1000000
bps-capacity=4000000
stale-nonce=600
pidfile=/tmp/coturn.pid
userdb=/tmp/turn-users.sqlite
log-file=stdout
simple-log
