# Include from the http {} context. Replace addresses, hostname and certificates.
map $http_upgrade $phone_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 9443 ssl;
    server_name home.example.com;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /absolute/private/path/fullchain.pem;
    ssl_certificate_key /absolute/private/path/privkey.pem;

    location = /phone {
        return 308 /phone/;
    }

    location /phone/ {
        proxy_pass http://192.0.2.20:8780;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Single internet-facing edge: replace incoming client-supplied XFF.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $phone_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
