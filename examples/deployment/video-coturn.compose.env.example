# Video-only settings; combine with one HTTPS entry and compose.coturn.yaml.
WEBRTC_ENABLED=1
WEBRTC_TURN_PROVIDER=coturn
WEBRTC_TURN_FALLBACK=
WEBRTC_ICE_MODE=relay
WEBRTC_STUN_URL=
WEBRTC_TURN_TTL_SECONDS=600
COTURN_KEY_PATH=./.local/coturn-key.json
COTURN_URL=turns:turn.example.com:8443?transport=tcp
# Optional backend listener; TLS still validates the browser-facing hostname.
# COTURN_SERVER_URL=turns:192.0.2.30:5349?transport=tcp
VIDEO_WSS_FALLBACK=1
WSS_ADAPTIVE_ENCODER=1
