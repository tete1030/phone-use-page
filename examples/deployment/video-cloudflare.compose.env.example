# Video-only settings; combine with one HTTPS entry and compose.turn.yaml.
WEBRTC_ENABLED=1
WEBRTC_TURN_PROVIDER=cloudflare
WEBRTC_TURN_FALLBACK=
WEBRTC_ICE_MODE=relay
WEBRTC_STUN_URL=
WEBRTC_TURN_TTL_SECONDS=600
CF_TURN_KEY_PATH=./.local/cloudflare-turn-key.json
VIDEO_WSS_FALLBACK=1
WSS_ADAPTIVE_ENCODER=1
