# Optional direct media; requires actual reachability, not just an HTTP tunnel.
WEBRTC_ENABLED=1
WEBRTC_TURN_PROVIDER=none
WEBRTC_TURN_FALLBACK=
WEBRTC_ICE_MODE=all
WEBRTC_STUN_URL=stun:stun.cloudflare.com:3478
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50031
# Only after verifying one-to-one UDP forwarding to the console:
# WEBRTC_PUBLIC_IP=203.0.113.10
VIDEO_WSS_FALLBACK=1
WSS_ADAPTIVE_ENCODER=1
