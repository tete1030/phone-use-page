# Local, USB-connected console. Copy to .env and adjust as needed.
HOST=127.0.0.1
PORT=8780
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50031
WEBRTC_STUN_URL=stun:stun.cloudflare.com:3478
WEBRTC_ICE_GATHER_MS=8000
# Optional Cloudflare TLS TURN; key JSON contains keyId/apiToken and must be 0600.
WEBRTC_TURN_PROVIDER=none
# WEBRTC_ICE_MODE=relay
# CF_TURN_KEY_FILE=.local/cloudflare-turn-key.json
WEBRTC_TURN_TTL_SECONDS=14400
# Self-hosted coturn alternative (JSON secret file, 0600):
# WEBRTC_TURN_PROVIDER=coturn
# WEBRTC_TURN_TTL_SECONDS=600
# COTURN_KEY_FILE=.local/coturn-key.json
# COTURN_URL=turns:turn.example.com:8443?transport=tcp
# COTURN_SERVER_URL=turns:192.0.2.10:5349?transport=tcp
# Later, after matching UDP NAT/firewall rules are configured:
# WEBRTC_PUBLIC_IP=203.0.113.5
ANDROID_SERIAL=
PYTHON_PATH=.venv/bin/python
# Required: supply your own unique password (12-512 characters).
# Choose CONSOLE_PASSWORD or CONSOLE_PASSWORD_FILE, not both.
CONSOLE_PASSWORD_FILE=.local/console-password
AUTH_DATA_DIR=.local/auth
AUTH_REMEMBER_DAYS=90
CONSOLE_COOKIE_PATH=/
CONSOLE_BASE_PATH=/
# ADB_PATH=/opt/homebrew/bin/adb
# KEEP_SCREEN_ON=1

# Required for a remotely accessible console, behind an HTTPS reverse proxy:
# HOST=0.0.0.0
# CONSOLE_PUBLIC_ORIGIN=https://android.example.com
# TRUST_PROXY=192.0.2.10/32

# Same-origin H.264 WSS fallback (FFmpeg for adaptive encoding):
# VIDEO_WSS_FALLBACK=1
# WSS_ADAPTIVE_ENCODER=1
