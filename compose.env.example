# Copy to .local/compose.env. This file contains paths/settings, never the password.
ANDROID_CONSOLE_IMAGE=android-console:local
CONSOLE_HTTP_HOST=127.0.0.1
CONSOLE_HTTP_PORT=8780
ANDROID_SERIAL=
CONSOLE_UID=
CONSOLE_GID=
# Required: the actual group GID granted access to your USB device (see docs/SETUP.md).
ANDROID_USB_GID=
CONSOLE_PASSWORD_PATH=./.local/console-password
CONSOLE_STATE_PATH=./.local/docker/state
CONSOLE_HOME_PATH=./.local/docker/home
AUTH_REMEMBER_DAYS=90
WEBRTC_PORT_MIN=50000
WEBRTC_PORT_MAX=50031
WEBRTC_ENABLED=0
# Empty means no external STUN discovery. Enable WebRTC explicitly to use it.
WEBRTC_STUN_URL=
WEBRTC_ICE_GATHER_MS=8000
WEBRTC_TURN_PROVIDER=none
WEBRTC_TURN_TTL_SECONDS=14400
# Enable with compose.yaml + compose.turn.yaml after preparing the private key.
# WEBRTC_ICE_MODE=relay
# CF_TURN_KEY_PATH=./.local/cloudflare-turn-key.json
# Self-hosted alternative: use compose.yaml + compose.coturn.yaml.
# COTURN_KEY_PATH=./.local/coturn-key.json
# WEBRTC_TURN_TTL_SECONDS=600
# COTURN_URL=turns:turn.example.com:8443?transport=tcp
# COTURN_SERVER_URL=turns:192.0.2.10:5349?transport=tcp

# Optional HTTPS reverse proxy configuration:
# CONSOLE_PUBLIC_ORIGIN=https://phone.example.com
# CONSOLE_BASE_PATH=/phone/
# CONSOLE_COOKIE_PATH=/phone/
# TRUST_PROXY=192.0.2.10/32
# WEBRTC_PUBLIC_IP=actual-public-ipv4

# Same-origin H.264 WSS fallback (FFmpeg for adaptive encoding):
VIDEO_WSS_FALLBACK=1
WSS_ADAPTIVE_ENCODER=1
VIDEO_MAX_SIZE=1920
VIDEO_MAX_FPS=30
VIDEO_BIT_RATE=4000000
